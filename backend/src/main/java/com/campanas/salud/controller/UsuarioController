package com.campanas.salud.controller;

import com.campanas.salud.model.Usuario;
import com.campanas.salud.repository.UsuarioRepository;
import com.campanas.salud.seguridad.Bitacora;
import com.campanas.salud.seguridad.SeguridadInterceptor;
import jakarta.servlet.http.HttpServletRequest;
import org.springframework.http.HttpStatus;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.server.ResponseStatusException;
import java.util.List;
import java.util.Set;

/** Gestión de usuarios para el administrador: ver, cambiar rol y dar de baja (RF-17). */
@RestController
@RequestMapping("/api/usuarios")
public class UsuarioController {
    public record CambioUsuario(String rol, String estado) { }

    private final UsuarioRepository repo;
    private final Bitacora bitacora;

    public UsuarioController(UsuarioRepository repo, Bitacora bitacora) {
        this.repo = repo;
        this.bitacora = bitacora;
    }

    @GetMapping
    public List<Usuario> listar() {
        return repo.findAll().stream().sorted(java.util.Comparator.comparing(Usuario::getId)).toList();
    }

    @PutMapping("/{id}")
    public Usuario cambiar(@PathVariable Long id, @RequestBody CambioUsuario c, HttpServletRequest req) {
        Usuario yo = (Usuario) req.getAttribute(SeguridadInterceptor.USUARIO);
        Usuario u = repo.findById(id).orElseThrow(() ->
                new ResponseStatusException(HttpStatus.NOT_FOUND, "Usuario no encontrado"));
        if (u.getId().equals(yo.getId()))
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "No puedes cambiar tu propia cuenta");
        if (c.rol() != null) {
            if (!Set.of("CIUDADANO", "ADMIN").contains(c.rol()))
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Rol no válido");
            u.setRol(c.rol());
        }
        if (c.estado() != null) {
            if (!Set.of("ACTIVO", "BAJA").contains(c.estado()))
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Estado no válido");
            u.setEstado(c.estado());
        }
        Usuario g = repo.save(u);
        bitacora.registrar(yo, "Cambió la cuenta de " + u.getCorreo() + " (rol " + u.getRol() + ", " + u.getEstado() + ")", "Usuario");
        return g;
    }
}
